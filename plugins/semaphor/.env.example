# Vite local development default. Keep this file ignored in customer apps.
VITE_SEMAPHOR_PROJECT_TOKEN=<project-token>

# Non-Vite or shell-env alternative.
# SEMAPHOR_PROJECT_TOKEN=<project-token>

# Optional override. Normally inferred from the project token apiServiceUrl.
# SEMAPHOR_MCP_URL=https://semaphor.cloud/api/mcp
